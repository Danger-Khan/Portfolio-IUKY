; start_gcode = M117 Heating and Homing... ; Display message on screen\nG90 ; Use absolute coordinates\nM83 ; Extruder relative mode\nG28 ; Home all axes\nM104 S[first_layer_temperature] ; Set extruder temperature without waiting\nM140 S[first_layer_bed_temperature] ; Set bed temperature without waiting\n\nM190 S[first_layer_bed_temperature] ; Wait for bed to reach temperature\nM109 S[first_layer_temperature] ; Wait for extruder to reach temperature\n\nG92 E0 ; Reset extrusion distance\nG1 Z5 F720 ; Move nozzle above the bed\nG1 X10 Z0.2 F720 ; Move nozzle slightly above the bed\nG1 X40 Y40 Z0.2 F1000 E10 ; Draw a prime line along the left edge\nG1 X40 Y180 Z0.2 F1000 E10 ;Draw an Second prime line along the left edge \n;G1 X180 Y180 Z0.2 F1000 E10 ;Draw an Third prime line along the left edge \n;G1 X180 Y40 Z0.2 F1000 E10 ;Draw an Fourth prime line along the left edge \n;G1 X40 Y40 Z0.2 F1000 E10 ;Draw an Fifth prime line along the left edge \nG28 ; Home all axes\nG1 Z10; Z AXIS FROM SAFE POINT.\nG92 E0 ; Reset extrusion distance\n
